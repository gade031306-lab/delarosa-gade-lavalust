# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# API token secrets (generate separate random values with php lava jwt:generate)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Exact origin of the deployed frontend, for example https://your-app.vercel.app
FRONTEND_ORIGIN=
